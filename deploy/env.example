# /srv/rps/.env on the server — made by server-setup.sh with fresh random secrets. Never copy it off the server,
# never commit it. Only SITE_DOMAIN and the optional lines below are filled in by hand.

# The web address of RPS (admin at /, API at /api). Point its DNS A record at the server first.
SITE_DOMAIN=rps.example.in

# Generated by server-setup.sh (openssl rand -hex 32). Changing a JWT secret signs everyone out.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILE_URL_SECRET=

# Which app version runs — set by ship.sh on every update.
RPS_VERSION=latest

# Off-server copies (optional but strongly advised): a Lightsail bucket + an access key for it.
BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Phone notifications (N1): after copying the Firebase key to /srv/rps/secrets/firebase-key.json
# (deploy runbook, step 5), set this to /run/secrets/firebase-key.json. Empty = notifications off.
FCM_CREDENTIALS_FILE=

# Alerts (optional): ping URLs from healthchecks.io — it emails you when a ping stops arriving.
HC_BACKUP_URL=
HC_UPTIME_URL=
