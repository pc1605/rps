# ───── Database ─────
DATABASE_URL=postgres://rps_dev:rps_dev_password@localhost:5433/rps?sslmode=disable
POSTGRES_DB=rps
POSTGRES_USER=rps_dev
POSTGRES_PASSWORD=rps_dev_password

# ───── JWT ─────
# The values below are development placeholders and are public (this file is in git).
# Production needs its own: `openssl rand -hex 32` for each secret. With ENV=production the
# backend refuses to start on a "change-me…" secret.
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars-long
JWT_REFRESH_SECRET=change-me-too-also-min-32-chars-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ───── Backend ─────
PORT=8080
ENV=development
LOG_LEVEL=debug
UPLOAD_DIR=./uploads

# ───── File URLs ─────
FILE_URL_SECRET=change-me-in-production-min-32-chars-long
FILE_URL_TTL_MINUTES=60
# Factory calendar timezone: report days and "completed today" (must match @rps/shared FACTORY_TZ)
FACTORY_TZ=Asia/Kolkata

# ───── Login limit ─────
# Failed logins allowed per address per 15 minutes, counted separately for admins and workers.
LOGIN_MAX_FAILURES=10
# Behind a host's proxy: the header that carries the real client address (set at deploy, e.g.
# X-Real-IP, Fly-Client-IP, CF-Connecting-IP). Empty = use the connection's address.
PROXY_HEADER=

# ───── Seed ─────
# Password for the owner account created by `go run ./cmd/seed` (12+ characters).
# Empty = the demo password, which the seed refuses when ENV=production.
SEED_ADMIN_PASSWORD=

# ───── Phone notifications (N1) ─────
# Path to the Firebase service-account key (JSON). Empty = notifications off. Never commit the key.
FCM_CREDENTIALS_FILE=

# ───── CORS ─────
# The admin web's origin(s). Never "*": the refresh cookie needs a named origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ───── Anthropic (Phase 7 — leave blank for now) ─────
ANTHROPIC_API_KEY=